# Copy to `.env` in this folder. Never commit `.env`.
# Restart Expo after changing these (`npx expo start --ios --port 8081`).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Redirect URLs to allow in Supabase → Authentication → URL configuration
# (Site URL can be http://localhost:8081 while developing.)
#
#   http://localhost:8081
#   http://localhost:8081/auth/callback
#   checkmed://
#   checkmed://auth/callback
#   exp://127.0.0.1:8081/--/auth/callback
#
# Expo Go prints the live redirect on the Sign in screen — add that exact URL too.
#
# Dashboard steps (Google / Facebook / Apple client IDs) are in the Phase 1 handoff,
# not in this file. Paste secrets only into the Supabase provider forms, never here.
