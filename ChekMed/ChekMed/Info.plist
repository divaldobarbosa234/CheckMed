<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Conny Cooper uses the camera to photograph prescriptions so Cooper can help you organize them. You review every field before anything is saved.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Conny Cooper can import a prescription photo from your library so Cooper can help you organize it. You review every field before anything is saved.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Conny Cooper uses your location only to search nearby pharmacies. Availability is not a medical recommendation — confirm stock with the pharmacy.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAlarmKitUsageDescription</key>
	<string>Conny Cooper uses alarms for medication dose times so Cooper can wake the device even in Silent or Focus. Stopping or snoozing an alarm does not mark a dose as taken — only an explicit confirmation does.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>GOOGLE_CLOUD_VISION_API_KEY</key>
	<string>$(GOOGLE_CLOUD_VISION_API_KEY)</string>
	<key>GOOGLE_CLOUD_PROJECT_ID</key>
	<string>$(GOOGLE_CLOUD_PROJECT_ID)</string>
	<key>GOOGLE_DOCUMENT_AI_LOCATION</key>
	<string>$(GOOGLE_DOCUMENT_AI_LOCATION)</string>
	<key>GOOGLE_DOCUMENT_AI_PROCESSOR_ID</key>
	<string>$(GOOGLE_DOCUMENT_AI_PROCESSOR_ID)</string>
	<key>GOOGLE_DOCUMENT_AI_CREDENTIALS_PATH</key>
	<string>$(GOOGLE_DOCUMENT_AI_CREDENTIALS_PATH)</string>
	<key>GOOGLE_DOCUMENT_AI_API_KEY</key>
	<string>$(GOOGLE_DOCUMENT_AI_API_KEY)</string>
	<key>AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT</key>
	<string>$(AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT)</string>
	<key>AZURE_DOCUMENT_INTELLIGENCE_KEY</key>
	<string>$(AZURE_DOCUMENT_INTELLIGENCE_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Google Sign-In</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_IOS_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
