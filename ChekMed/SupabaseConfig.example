// Copy this file to Secrets.xcconfig in this same ChekMed/ folder.
// Secrets.xcconfig is gitignored. Never commit real keys.
//
// xcconfig treats // as a comment, so write the URL as:
//   SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
//
// Paste the publishable key (sb_publishable_…) or the legacy anon JWT from
// Supabase → Project Settings → API. Never put the service_role key in the app.
//
// Google Cloud Console → APIs & Services → Credentials → your iOS OAuth 2.0 Client ID:
//   Client ID      → GOOGLE_IOS_CLIENT_ID
//                    (injected as Info.plist GIDClientID; ends in .apps.googleusercontent.com)
//   iOS URL scheme → GOOGLE_IOS_REVERSED_CLIENT_ID
//                    (reversed client ID). After you paste the real value, add it as a
//                    CFBundleURLTypes / CFBundleURLSchemes entry in Info.plist.
// Do not invent Client IDs, Bundle IDs, or Team IDs.

SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_OR_ANON_KEY
GOOGLE_IOS_CLIENT_ID =
GOOGLE_IOS_REVERSED_CLIENT_ID =
